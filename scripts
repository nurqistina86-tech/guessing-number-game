// Guessing Number Game
// 6th Workshop: JavaScript Exploring

function generateRandomNumber() {
    return Math.floor(Math.random() * 11);
}

function playGuessingGame() {

    let playAgain = true;

    while (playAgain) {

        let secretNumber = generateRandomNumber();
        let guessedCorrectly = false;

        alert("Welcome to Guessing Number Game! I have chosen a number between 0 and 10.");

        while (!guessedCorrectly) {

            let userInput = prompt("Guess a number between 0 and 10:");

            if (userInput === null) {
                alert("You quit the game. Thank you for playing!");
                return;
            }

            let guess = Number(userInput);

            if (
                userInput.trim() === "" ||
                !Number.isInteger(guess) ||
                guess < 0 ||
                guess > 10
            ) {
                alert("Please enter a valid number between 0 and 10.");
            }

            else if (guess === secretNumber) {
                alert("Yeah, you guessed it!");
                guessedCorrectly = true;
            }

            else if (guess < secretNumber) {
                alert("Too low, try again!");
            }

            else {
                alert("Too high, try again!");
            }
        }

        playAgain = confirm("Do you want to play again?");

        if (!playAgain) {
            alert("Thank you for playing!");
        }
    }
}

// Start the game
playGuessingGame();